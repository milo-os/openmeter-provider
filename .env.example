# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Stripe test-mode secret key (starts with sk_test_), used by
# `task dev:install-stripe-app` (also run automatically as part of
# `task dev:install-dependencies` / `task dev:setup`) to install a real
# Stripe app on the dev OpenMeter instance via
# POST /api/v1/marketplace/listings/stripe/install/apikey. Safe to use a
# real Stripe account's test-mode key: no OAuth flow, no real money moves.
# Leave unset to skip Stripe app installation (BillingAccountReconciler's
# Stripe app-data sync will 412 with "no stripe app found in billing
# profile" until this is set — see TODO.md).
STRIPE_TEST_API_KEY=
